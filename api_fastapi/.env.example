# ═════════════════════════════════════════════════════════════════════════════
# 📋 .env.example - Arquivo de exemplo de variáveis de ambiente
#
# INSTRUÇÕES:
# 1. Copiar este arquivo para .env
#     cp .env.example .env
# 2. Preencher valores específicos do seu ambiente
# 3. NUNCA commitar .env com valores reais (adicionar ao .gitignore)
# 4. Em produção, usar secret manager (Vault, AWS Secrets, etc)
#
# SEGURANÇA:
# ⚠️  NUNCA colocar chaves reais neste arquivo
# ⚠️  NUNCA fazer commit de .env com dados sensíveis
# ⚠️  Sempre manter secrets/keys em variáveis de ambiente
# ═════════════════════════════════════════════════════════════════════════════


# ═════════════════════════════════════════════════════════════════════════════
# SEÇÃO 1: AMBIENTE E DEBUG
# ═════════════════════════════════════════════════════════════════════════════

# development | staging | production
ENVIRONMENT=development

# Ativar modo debug (hot reload, mais logs)
DEBUG=true

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ═════════════════════════════════════════════════════════════════════════════
# SEÇÃO 2: API FASTAPI
# ═════════════════════════════════════════════════════════════════════════════

# Título da aplicação (para documentação)
API_TITLE=Lumemei AI API

# Versão (semantic versioning)
API_VERSION=0.1.0

# Descrição (para documentação)
API_DESCRIPTION=API Python com IA para gestão financeira de MEI

# Host e porta de listen
API_HOST=0.0.0.0
API_PORT=8000

# Hot reload em desenvolvimento (desativar em produção)
API_RELOAD=true


# ═════════════════════════════════════════════════════════════════════════════
# SEÇÃO 3: GOOGLE GEMINI API
# ═════════════════════════════════════════════════════════════════════════════

# Sua API key do Google Gemini
# Obter em: https://aistudio.google.com/app/apikey
# ⚠️  NUNCA compartilhar essa chave!
GEMINI_API_KEY=your-gemini-api-key-here

# Modelo do Gemini a usar
# Opções: gemini-2.0-flash (rápido, barato), gemini-1.5-pro (mais poderoso)
GEMINI_MODEL=gemini-2.0-flash

# Timeout para chamadas ao Gemini (em segundos)
GEMINI_TIMEOUT=30

# Número de retentativas em caso de erro
GEMINI_MAX_RETRIES=3


# ═════════════════════════════════════════════════════════════════════════════
# SEÇÃO 4: INTEGRAÇÃO COM API C# (BACKEND CORE)
# ═════════════════════════════════════════════════════════════════════════════

# URL base da API ASP.NET Core (seu backend em C#)
# Exemplo local: http://localhost:5000
# Exemplo cloud: https://api.seudominio.com
CSHARP_API_URL=http://localhost:5000

# Timeout para requisições ao C# (em segundos)
CSHARP_API_TIMEOUT=30

# Endpoints do C# (não é necessário mudar, valor padrão é este)
CSHARP_CONTEXT_ENDPOINT=/api/context/{mei_id}
CSHARP_WEBHOOK_CHAT_ENDPOINT=/api/ai-callback/chat
CSHARP_WEBHOOK_IMPORT_ENDPOINT=/api/ai-callback/import
CSHARP_WEBHOOK_SIMULATION_ENDPOINT=/api/ai-callback/simulation


# ═════════════════════════════════════════════════════════════════════════════
# SEÇÃO 5: WEBHOOK E SEGURANÇA
# ═════════════════════════════════════════════════════════════════════════════

# Chave secreta para HMAC (validação de webhooks)
# Gerar com: openssl rand -hex 32
# ⚠️  Manter seguro!
WEBHOOK_SECRET_KEY=your-secret-key-here-change-in-production

# Validar assinatura HMAC dos webhooks (segurança)
WEBHOOK_VERIFY_HMAC=true

# Timeout para chamadas de webhook (em segundos)
WEBHOOK_TIMEOUT=10


# ═════════════════════════════════════════════════════════════════════════════
# SEÇÃO 6: VECTOR STORE E RAG (Futuro - FASE 5)
# ═════════════════════════════════════════════════════════════════════════════

# Diretório para banco de dados vetorial ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Nome da collection padrão no ChromaDB
CHROMA_COLLECTION_NAME=lumemei_docs

# Modelo para gerar embeddings (buscar no HuggingFace)
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2


# ═════════════════════════════════════════════════════════════════════════════
# SEÇÃO 7: REDIS (Futuro - para fila de tarefas)
# ═════════════════════════════════════════════════════════════════════════════

# URL do Redis (se usar fila de tarefas)
# Exemplo local: redis://localhost:6379
# Deixar vazio se não usar Redis ainda
REDIS_URL=

# Timeout de tarefas assíncronas (em segundos)
TASK_TIMEOUT=300


# ═════════════════════════════════════════════════════════════════════════════
# SEÇÃO 8: UPLOAD DE ARQUIVOS
# ═════════════════════════════════════════════════════════════════════════════

# Diretório para salvar arquivos uploaded
UPLOAD_DIR=./uploads

# Tamanho máximo de arquivo (em MB)
MAX_FILE_SIZE_MB=50

# Extensões permitidas (separadas por vírgula)
ALLOWED_EXTENSIONS=csv,xlsx,xls,json
