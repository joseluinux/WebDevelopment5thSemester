
# Ambiente de desenvolvimento
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API FastAPI
API_TITLE=Lumemei AI API
API_VERSION=0.1.0
API_DESCRIPTION=API Python com IA para gestão financeira de MEI
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

GEMINI_API_KEY=AIzaSyC5-culMBX2CC4zFhwhK5Yf7pfuSIsB594

# Modelo Gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=30
GEMINI_MAX_RETRIES=3

# LLM Provider ativo: "gemini" ou "ollama"
LLM_PROVIDER=gemini

# Ollama (local) — rode: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Backend C# (local)
CSHARP_API_URL=http://localhost:5000
CSHARP_API_TIMEOUT=30
CSHARP_CONTEXT_ENDPOINT=/api/context/{mei_id}
CSHARP_WEBHOOK_CHAT_ENDPOINT=/api/ai-callback/chat
CSHARP_WEBHOOK_IMPORT_ENDPOINT=/api/ai-callback/import
CSHARP_WEBHOOK_SIMULATION_ENDPOINT=/api/ai-callback/simulation

# Webhook (secret para HMAC)
WEBHOOK_SECRET_KEY=seu-secret-key-teste-12345
WEBHOOK_VERIFY_HMAC=true
WEBHOOK_TIMEOUT=10

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=csv,xlsx,xls,json
